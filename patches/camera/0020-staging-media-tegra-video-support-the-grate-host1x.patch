diff --git a/drivers/staging/media/tegra-video/host1x-compat.h b/drivers/staging/media/tegra-video/host1x-compat.h
new file mode 100644
index 000000000..7efe3e56e
--- /dev/null
+++ b/drivers/staging/media/tegra-video/host1x-compat.h
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * host1x API selection for the Tegra video driver.
+ *
+ * The grate host1x (CONFIG_GRATE_HOST1X) is a fork of the mainline driver with a
+ * different sync point API: a sync point can be allocated, read and released, but
+ * the mainline request-with-flags, id and wait-on-threshold calls do not exist.
+ * This header gives the video driver one set of helpers for both.
+ */
+
+#ifndef __TEGRA_VIDEO_HOST1X_COMPAT_H__
+#define __TEGRA_VIDEO_HOST1X_COMPAT_H__
+
+#if IS_ENABLED(CONFIG_GRATE_HOST1X)
+
+#include <linux/delay.h>
+#include <linux/host1x-grate.h>
+#include <linux/jiffies.h>
+
+/* the grate host1x_driver.remove callback returns int, the mainline one is void */
+#define TEGRA_HOST1X_REMOVE_RET		int
+#define TEGRA_HOST1X_REMOVE_RETURN	return 0
+
+static inline struct host1x_syncpt *
+tegra_vi_syncpt_request(struct host1x_client *client)
+{
+	struct host1x *host = dev_get_drvdata(client->host->parent);
+	struct host1x_syncpt *sp = host1x_syncpt_request(host);
+
+	return IS_ERR(sp) ? NULL : sp;
+}
+
+static inline u32 tegra_vi_syncpt_id(struct host1x_syncpt *sp)
+{
+	return sp->id;
+}
+
+/* Polls the hardware counter; returns 0 once it reaches @thresh, -EAGAIN on timeout. */
+static inline int tegra_vi_syncpt_wait(struct host1x_syncpt *sp, u32 thresh,
+				       long timeout)
+{
+	unsigned long end = jiffies + timeout;
+
+	while ((s32)(host1x_syncpt_read(sp) - thresh) < 0) {
+		if (time_after(jiffies, end))
+			return -EAGAIN;
+
+		usleep_range(500, 1000);
+	}
+
+	return 0;
+}
+
+#else
+
+#include <linux/host1x.h>
+
+#define TEGRA_HOST1X_REMOVE_RET		void
+#define TEGRA_HOST1X_REMOVE_RETURN
+
+static inline struct host1x_syncpt *
+tegra_vi_syncpt_request(struct host1x_client *client)
+{
+	return host1x_syncpt_request(client, HOST1X_SYNCPT_CLIENT_MANAGED);
+}
+
+static inline u32 tegra_vi_syncpt_id(struct host1x_syncpt *sp)
+{
+	return host1x_syncpt_id(sp);
+}
+
+static inline int tegra_vi_syncpt_wait(struct host1x_syncpt *sp, u32 thresh,
+				       long timeout)
+{
+	return host1x_syncpt_wait(sp, thresh, timeout, NULL);
+}
+
+#endif
+
+#endif
