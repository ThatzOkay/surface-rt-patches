+               emit_reload_scalar(fp, loc, 12 | (slot << 6));
+               fp->temp_src[src->Index][c] = loc;
+               fp->temp_dst[src->Index][c] = loc;
+               fp->pinned[loc & 0x7f] |= scalar_mask(loc);
+            }
+         }
