From: Surface RT bring-up
Subject: [PATCH 9/9] grate: accept RGBA texture storage and reject unknown formats

Weston uploads a 1x1 R8G8B8A8 texture. The sampler-only capability query
accepted it but resource creation asserted because its format was unmapped.
Add the RGBA storage mapping, constrain non-buffer format reporting, and
return an error with a format name instead of asserting. Keep RGBA render
targets disabled: enabling them selects an incomplete GPU readback path.
Remove the incorrect 128-bit float to 64-bit float storage alias.

--- a/src/gallium/drivers/grate/grate_resource.c
+++ b/src/gallium/drivers/grate/grate_resource.c
@@ -152,8 +152,10 @@
    case PIPE_FORMAT_B8G8R8A8_UNORM:
    case PIPE_FORMAT_B8G8R8X8_UNORM:
       return TGR3D_SURF_FORMAT_R8G8B8A8;
-   case PIPE_FORMAT_R32G32B32A32_FLOAT:
-      return TGR3D_SURF_FORMAT_R16G16B16A16_float;
+   /* Surface names use the opposite byte order to Gallium's format names. */
+   case PIPE_FORMAT_R8G8B8A8_UNORM:
+   case PIPE_FORMAT_R8G8B8X8_UNORM:
+      return TGR3D_SURF_FORMAT_B8G8R8A8;
    default:
       return -1;
    }
@@ -193,7 +195,13 @@
    if (template->target != PIPE_BUFFER) {
       /* pick pixel-format */
       int format = grate_pixel_format(template->format);
-      assert(format >= 0);
+      if (format < 0) {
+         grate_loge("unsupported resource format %s (target=%u bind=0x%x)\n",
+                    util_format_name(template->format), template->target,
+                    template->bind);
+         FREE(resource);
+         return NULL;
+      }
       resource->format = format;
    }
 
@@ -202,6 +210,7 @@
    resource->bo = grate_bo_alloc(screen->drm, size, flags);
    if (!resource->bo) {
       fprintf(stderr, "grate_bo_alloc() failed\n");
+      FREE(resource);
       return NULL;
    }
 
@@ -244,12 +253,17 @@
    resource->pitch = handle->stride;
 
    format = grate_pixel_format(template->format);
-   assert(format >= 0);
+   if (format < 0) {
+      grate_loge("unsupported imported format %s\n",
+                 util_format_name(template->format));
+      goto fail;
+   }
    resource->format = format;
 
    return &resource->b;
    
 fail:
+   grate_bo_unref(resource->bo);
    FREE(resource);
    return NULL;
 }
--- a/src/gallium/drivers/grate/grate_screen.c
+++ b/src/gallium/drivers/grate/grate_screen.c
@@ -382,6 +382,21 @@
                                  unsigned storage_sample_count,
                                  unsigned usage)
 {
+   if (MAX2(1, sample_count) != 1 || MAX2(1, storage_sample_count) != 1)
+      return false;
+
+   if (target != PIPE_BUFFER && grate_pixel_format(format) < 0)
+      return false;
+
+   /* RGBA storage is needed for sampler uploads.  Advertising it as a render
+    * target also enables Mesa's GPU readback conversion path, which this
+    * driver cannot yet execute (fragment uniforms and blits are incomplete).
+    */
+   if ((usage & (PIPE_BIND_RENDER_TARGET | PIPE_BIND_SCANOUT)) &&
+       (format == PIPE_FORMAT_R8G8B8A8_UNORM ||
+        format == PIPE_FORMAT_R8G8B8X8_UNORM))
+      return false;
+
    if (usage & (PIPE_BIND_RENDER_TARGET | PIPE_BIND_DEPTH_STENCIL)) {
       if (grate_pixel_format(format) < 0)
          return false;
