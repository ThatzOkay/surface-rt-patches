diff --git a/src/gallium/drivers/grate/fp/blend.c b/src/gallium/drivers/grate/fp/blend.c
index 78c62ccce1b..5f58085b292 100644
--- a/src/gallium/drivers/grate/fp/blend.c
+++ b/src/gallium/drivers/grate/fp/blend.c
@@ -1,3 +1,5 @@
+#include <string.h>
+
 #include "util/macros.h"
 
 #include "blend.h"
@@ -352,3 +354,113 @@ grate_fp_blend_alu(uint32_t key,
 
    return num_packets;
 }
+
+static bool
+factor_is_dual(enum pipe_blendfactor factor)
+{
+   switch (factor) {
+   case PIPE_BLENDFACTOR_SRC1_COLOR:
+   case PIPE_BLENDFACTOR_SRC1_ALPHA:
+   case PIPE_BLENDFACTOR_INV_SRC1_COLOR:
+   case PIPE_BLENDFACTOR_INV_SRC1_ALPHA:
+      return true;
+   default:
+      return false;
+   }
+}
+
+bool
+grate_fp_blend_is_dual(const struct pipe_rt_blend_state *rt)
+{
+   return rt->blend_enable && (factor_is_dual(rt->rgb_src_factor) ||
+                               factor_is_dual(rt->alpha_src_factor) ||
+                               factor_is_dual(rt->rgb_dst_factor) ||
+                               factor_is_dual(rt->alpha_dst_factor));
+}
+
+/* The factors a pass may use, one row each. `colour` and `alpha` are how
+ * the factor reads when the colour channels / the alpha channel are blended
+ * against the stored colour (src1 is stored as the colour in the dst pass).
+ */
+static const struct {
+   enum pipe_blendfactor factor;
+   enum grate_fp_dual_factor dual;
+   enum pipe_blendfactor colour;
+   enum pipe_blendfactor alpha;
+} dual_factors[] = {
+   {PIPE_BLENDFACTOR_ZERO, GRATE_FP_DUAL_ZERO, PIPE_BLENDFACTOR_ZERO,
+    PIPE_BLENDFACTOR_ZERO},
+   {PIPE_BLENDFACTOR_ONE, GRATE_FP_DUAL_ONE, PIPE_BLENDFACTOR_ONE,
+    PIPE_BLENDFACTOR_ONE},
+   {PIPE_BLENDFACTOR_SRC1_COLOR, GRATE_FP_DUAL_SRC1_COLOR,
+    PIPE_BLENDFACTOR_SRC_COLOR, PIPE_BLENDFACTOR_SRC_ALPHA},
+   {PIPE_BLENDFACTOR_INV_SRC1_COLOR, GRATE_FP_DUAL_INV_SRC1_COLOR,
+    PIPE_BLENDFACTOR_INV_SRC_COLOR, PIPE_BLENDFACTOR_INV_SRC_ALPHA},
+   {PIPE_BLENDFACTOR_SRC1_ALPHA, GRATE_FP_DUAL_SRC1_ALPHA,
+    PIPE_BLENDFACTOR_SRC_ALPHA, PIPE_BLENDFACTOR_SRC_ALPHA},
+   {PIPE_BLENDFACTOR_INV_SRC1_ALPHA, GRATE_FP_DUAL_INV_SRC1_ALPHA,
+    PIPE_BLENDFACTOR_INV_SRC_ALPHA, PIPE_BLENDFACTOR_INV_SRC_ALPHA},
+};
+
+static bool
+dual_factor_lookup(enum pipe_blendfactor factor, unsigned *index)
+{
+   for (unsigned i = 0; i < ARRAY_SIZE(dual_factors); i++) {
+      if (dual_factors[i].factor == factor) {
+         *index = i;
+         return true;
+      }
+   }
+   return false;
+}
+
+bool
+grate_fp_blend_dual_plan(const struct pipe_rt_blend_state *rt,
+                         struct grate_fp_dual_plan *plan)
+{
+   unsigned src_rgb, src_alpha, dst_rgb, dst_alpha;
+
+   memset(plan, 0, sizeof(*plan));
+
+   /* Only sums: both passes add their term. */
+   if (rt->rgb_func != PIPE_BLEND_ADD || rt->alpha_func != PIPE_BLEND_ADD)
+      return false;
+
+   if (!dual_factor_lookup(rt->rgb_src_factor, &src_rgb) ||
+       !dual_factor_lookup(rt->alpha_src_factor, &src_alpha) ||
+       !dual_factor_lookup(rt->rgb_dst_factor, &dst_rgb) ||
+       !dual_factor_lookup(rt->alpha_dst_factor, &dst_alpha))
+      return false;
+
+   /* dst * Fd, unless Fd is one */
+   if (dual_factors[dst_rgb].factor != PIPE_BLENDFACTOR_ONE ||
+       dual_factors[dst_alpha].factor != PIPE_BLENDFACTOR_ONE) {
+      struct grate_fp_dual_pass *pass = &plan->pass[plan->num_passes++];
+
+      pass->output.mode = GRATE_FP_OUTPUT_SRC1;
+      pass->rt = *rt;
+      pass->rt.rgb_func = pass->rt.alpha_func = PIPE_BLEND_ADD;
+      pass->rt.rgb_src_factor = pass->rt.alpha_src_factor =
+         PIPE_BLENDFACTOR_ZERO;
+      pass->rt.rgb_dst_factor = dual_factors[dst_rgb].colour;
+      pass->rt.alpha_dst_factor = dual_factors[dst_alpha].alpha;
+   }
+
+   /* + src0 * Fs, unless Fs is zero */
+   if (dual_factors[src_rgb].factor != PIPE_BLENDFACTOR_ZERO ||
+       dual_factors[src_alpha].factor != PIPE_BLENDFACTOR_ZERO) {
+      struct grate_fp_dual_pass *pass = &plan->pass[plan->num_passes++];
+
+      pass->output.mode = GRATE_FP_OUTPUT_SRC0_TIMES_FACTOR;
+      pass->output.factor[0] = dual_factors[src_rgb].dual;
+      pass->output.factor[1] = dual_factors[src_alpha].dual;
+      pass->rt = *rt;
+      pass->rt.rgb_func = pass->rt.alpha_func = PIPE_BLEND_ADD;
+      pass->rt.rgb_src_factor = pass->rt.alpha_src_factor =
+         PIPE_BLENDFACTOR_ONE;
+      pass->rt.rgb_dst_factor = pass->rt.alpha_dst_factor =
+         PIPE_BLENDFACTOR_ONE;
+   }
+
+   return true;
+}
diff --git a/src/gallium/drivers/grate/fp/blend.h b/src/gallium/drivers/grate/fp/blend.h
index c34947d4c25..c328a89fdeb 100644
--- a/src/gallium/drivers/grate/fp/blend.h
+++ b/src/gallium/drivers/grate/fp/blend.h
@@ -5,6 +5,8 @@
 
 #include "pipe/p_state.h"
 
+#include "grate_compiler.h"
+
 /* Blend epilogue of the fragment program, see blend.c. */
 
 #define GRATE_FP_BLEND_MAX_PACKETS 3
@@ -26,4 +28,43 @@ uint32_t grate_fp_blend_key(const struct pipe_rt_blend_state *rt);
 unsigned grate_fp_blend_alu(uint32_t key,
                             uint32_t words[GRATE_FP_BLEND_MAX_PACKETS * 8]);
 
+/**
+ * Dual-source blending (GL_EXT_blend_func_extended), where factors come from
+ * the fragment program's second output, src1:
+ *
+ *    out = src0 * Fs + dst * Fd         with Fs, Fd made of src1
+ *
+ * The epilogue cannot hold src0, src1 and the destination at once (a
+ * per-pixel value in a global register does not survive the destination
+ * read, and R0-R3 hold eight FX10 values), so the draw is split in
+ * passes that each blend one colour, which is exact as long as the
+ * fragments of one draw do not overlap:
+ *
+ *    pass dst:  colour = src1,           blend ZERO, Fd'      -> dst * Fd
+ *    pass src:  colour = src0 * Fs(src1), blend ONE, ONE      -> + src0 * Fs
+ *
+ * where Fd' is Fd written with the colour (SRC1_COLOR -> SRC_COLOR).
+ */
+#define GRATE_FP_DUAL_MAX_PASSES 2
+
+struct grate_fp_dual_pass {
+   struct grate_fp_output output; /* what the fragment program stores */
+   struct pipe_rt_blend_state rt; /* how that colour is blended */
+};
+
+struct grate_fp_dual_plan {
+   unsigned num_passes;
+   struct grate_fp_dual_pass pass[GRATE_FP_DUAL_MAX_PASSES];
+};
+
+/** True if a factor of the state comes from src1. */
+bool grate_fp_blend_is_dual(const struct pipe_rt_blend_state *rt);
+
+/**
+ * Splits a dual-source state of render target 0 in passes. Returns false
+ * for a combination that has no such split (the caller logs the state).
+ */
+bool grate_fp_blend_dual_plan(const struct pipe_rt_blend_state *rt,
+                              struct grate_fp_dual_plan *plan);
+
 #endif
diff --git a/src/gallium/drivers/grate/fp/tgsi.c b/src/gallium/drivers/grate/fp/tgsi.c
index 809764923d2..703c8b03983 100644
--- a/src/gallium/drivers/grate/fp/tgsi.c
+++ b/src/gallium/drivers/grate/fp/tgsi.c
@@ -1131,9 +1131,119 @@ forward_tex_coord(struct tgsi_full_instruction *code, unsigned count)
    return count;
 }
 
+/* Append the instructions for dual-source output modes (see
+ * enum grate_fp_output_mode). t0 and t1 are the temporaries that hold
+ * output 0 and 1. Returns the temporary to store as the colour. */
+static bool
+build_dual_output(struct grate_fp_shader *fp,
+                  struct util_dynarray *instructions,
+                  const struct grate_fp_output *output,
+                  const int *output_temps, const unsigned *output_masks,
+                  int *result)
+{
+   if (output_temps[1] < 0) {
+      fprintf(stderr, "GRATE FRAG: dual-source blending but the program "
+                      "has no second output\n");
+      fp->allocation_failed = true;
+      return false;
+   }
+
+   if (output->mode == GRATE_FP_OUTPUT_SRC1) {
+      *result = output_temps[1];
+      return true;
+   }
+
+   assert(fp->num_temporaries < GRATE_FP_MAX_TEMPS);
+   unsigned factor_temp = fp->num_temporaries++;
+   unsigned one_comp, zero_comp;
+   unsigned one_imm = find_immediate(fp, 1.0f, &one_comp);
+   unsigned zero_imm = find_immediate(fp, 0.0f, &zero_comp);
+
+   /* group 0: the colour channels, group 1: alpha */
+   for (unsigned group = 0; group < 2; group++) {
+      enum grate_fp_dual_factor factor = output->factor[group];
+      unsigned mask = group ? TGSI_WRITEMASK_W : TGSI_WRITEMASK_XYZ;
+      struct tgsi_full_instruction mov = {0};
+
+      mov.Instruction.Opcode = TGSI_OPCODE_MOV;
+      mov.Instruction.NumDstRegs = 1;
+      mov.Instruction.NumSrcRegs = 1;
+      mov.Dst[0].Register.File = TGSI_FILE_TEMPORARY;
+      mov.Dst[0].Register.Index = factor_temp;
+      mov.Dst[0].Register.WriteMask = mask;
+
+      bool invert = factor == GRATE_FP_DUAL_INV_SRC1_COLOR ||
+                    factor == GRATE_FP_DUAL_INV_SRC1_ALPHA;
+      if (factor == GRATE_FP_DUAL_ZERO || factor == GRATE_FP_DUAL_ONE) {
+         unsigned comp = factor == GRATE_FP_DUAL_ONE ? one_comp : zero_comp;
+
+         mov.Src[0].Register.File = TGSI_FILE_IMMEDIATE;
+         mov.Src[0].Register.Index =
+            factor == GRATE_FP_DUAL_ONE ? one_imm : zero_imm;
+         set_src_swizzle(&mov.Src[0].Register, comp, comp, comp, comp);
+      } else {
+         mov.Src[0].Register.File = TGSI_FILE_TEMPORARY;
+         mov.Src[0].Register.Index = output_temps[1];
+         if (factor == GRATE_FP_DUAL_SRC1_COLOR ||
+             factor == GRATE_FP_DUAL_INV_SRC1_COLOR)
+            set_src_swizzle(&mov.Src[0].Register, TGSI_SWIZZLE_X,
+                            TGSI_SWIZZLE_Y, TGSI_SWIZZLE_Z, TGSI_SWIZZLE_W);
+         else
+            set_src_swizzle(&mov.Src[0].Register, TGSI_SWIZZLE_W,
+                            TGSI_SWIZZLE_W, TGSI_SWIZZLE_W, TGSI_SWIZZLE_W);
+      }
+      util_dynarray_append_typed(instructions, struct tgsi_full_instruction,
+                                 mov);
+
+      if (invert) {
+         /* factor = 1 - factor */
+         struct tgsi_full_instruction add = {0};
+
+         add.Instruction.Opcode = TGSI_OPCODE_ADD;
+         add.Instruction.NumDstRegs = 1;
+         add.Instruction.NumSrcRegs = 2;
+         add.Dst[0] = mov.Dst[0];
+         add.Src[0].Register.File = TGSI_FILE_IMMEDIATE;
+         add.Src[0].Register.Index = one_imm;
+         set_src_swizzle(&add.Src[0].Register, one_comp, one_comp, one_comp,
+                         one_comp);
+         add.Src[1].Register.File = TGSI_FILE_TEMPORARY;
+         add.Src[1].Register.Index = factor_temp;
+         add.Src[1].Register.Negate = 1;
+         set_src_swizzle(&add.Src[1].Register, TGSI_SWIZZLE_X, TGSI_SWIZZLE_Y,
+                         TGSI_SWIZZLE_Z, TGSI_SWIZZLE_W);
+         util_dynarray_append_typed(instructions,
+                                    struct tgsi_full_instruction, add);
+      }
+   }
+
+   /* factor = src0 * factor */
+   struct tgsi_full_instruction mul = {0};
+
+   mul.Instruction.Opcode = TGSI_OPCODE_MUL;
+   mul.Instruction.NumDstRegs = 1;
+   mul.Instruction.NumSrcRegs = 2;
+   mul.Dst[0].Register.File = TGSI_FILE_TEMPORARY;
+   mul.Dst[0].Register.Index = factor_temp;
+   mul.Dst[0].Register.WriteMask = TGSI_WRITEMASK_XYZW;
+   mul.Src[0].Register.File = TGSI_FILE_TEMPORARY;
+   mul.Src[0].Register.Index = output_temps[0];
+   mul.Src[1].Register.File = TGSI_FILE_TEMPORARY;
+   mul.Src[1].Register.Index = factor_temp;
+   for (unsigned i = 0; i < 2; i++) {
+      set_src_swizzle(&mul.Src[i].Register, TGSI_SWIZZLE_X, TGSI_SWIZZLE_Y,
+                      TGSI_SWIZZLE_Z, TGSI_SWIZZLE_W);
+   }
+   util_dynarray_append_typed(instructions, struct tgsi_full_instruction,
+                              mul);
+
+   *result = factor_temp;
+   return true;
+}
+
 void
-grate_tgsi_to_fp(struct grate_fp_shader *fp,
-                 struct tgsi_parse_context *tgsi)
+grate_tgsi_to_fp(struct grate_fp_shader *fp, struct tgsi_parse_context *tgsi,
+                 const struct grate_fp_output *output)
 {
    list_inithead(&fp->fp_instructions);
    list_inithead(&fp->alu_instructions);
@@ -1205,22 +1315,32 @@ grate_tgsi_to_fp(struct grate_fp_shader *fp,
          dst->Index = output_temps[index];
       }
    }
-   for (unsigned out = 0; out < 16; out++) {
-      if (output_temps[out] < 0) continue;
+   /* One colour is stored: output 0, or what a dual-source pass makes of
+    * the two outputs. */
+   int stored_temp = output_temps[0];
+   if (output->mode != GRATE_FP_OUTPUT_SRC0 &&
+       !build_dual_output(fp, &instructions, output, output_temps,
+                          output_masks, &stored_temp)) {
+      util_dynarray_fini(&instructions);
+      return;
+   }
+   if (stored_temp >= 0) {
       struct tgsi_full_instruction store = {0};
+
       store.Instruction.Opcode = TGSI_OPCODE_MOV;
       store.Instruction.NumDstRegs = 1;
       store.Instruction.NumSrcRegs = 1;
       store.Dst[0].Register.File = TGSI_FILE_OUTPUT;
-      store.Dst[0].Register.Index = out;
-      store.Dst[0].Register.WriteMask = output_masks[out];
+      store.Dst[0].Register.Index = 0;
+      store.Dst[0].Register.WriteMask = output->mode == GRATE_FP_OUTPUT_SRC1
+                                           ? output_masks[1]
+                                           : output_masks[0];
       store.Src[0].Register.File = TGSI_FILE_TEMPORARY;
-      store.Src[0].Register.Index = output_temps[out];
-      store.Src[0].Register.SwizzleX = TGSI_SWIZZLE_X;
-      store.Src[0].Register.SwizzleY = TGSI_SWIZZLE_Y;
-      store.Src[0].Register.SwizzleZ = TGSI_SWIZZLE_Z;
-      store.Src[0].Register.SwizzleW = TGSI_SWIZZLE_W;
-      util_dynarray_append_typed(&instructions, struct tgsi_full_instruction, store);
+      store.Src[0].Register.Index = stored_temp;
+      set_src_swizzle(&store.Src[0].Register, TGSI_SWIZZLE_X, TGSI_SWIZZLE_Y,
+                      TGSI_SWIZZLE_Z, TGSI_SWIZZLE_W);
+      util_dynarray_append_typed(&instructions, struct tgsi_full_instruction,
+                                 store);
    }
    assert(fp->num_temporaries < GRATE_FP_MAX_TEMPS);
    unsigned count = util_dynarray_num_elements(&instructions, struct tgsi_full_instruction);
diff --git a/src/gallium/drivers/grate/grate_compiler.h b/src/gallium/drivers/grate/grate_compiler.h
index 95d88f2dbb9..a085ea88510 100644
