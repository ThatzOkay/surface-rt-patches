From: Surface RT bring-up
Subject: [PATCH 11/11] grate: upload fragment uniforms and arbitrary immediates

Map used scalar constants to the fragment ALU's 32 FP20 registers, upload
values on each draw, preserve source modifiers, and correct the constant
buffer capability from 32 bytes to 32 floats. Uniforms and nontrivial
immediates share the bank; zero/one immediates keep their existing encoding.
Only direct indexing of constant buffer zero is supported.

--- a/src/gallium/drivers/grate/fp/tgsi.c
+++ b/src/gallium/drivers/grate/fp/tgsi.c
@@ -92,6 +92,25 @@
 }
 
 static struct fp_alu_src_operand
+fp_constant(struct grate_fp_shader *fp, int word, float immediate)
+{
+   unsigned i;
+   for (i = 0; i < fp->info.num_constants; i++) {
+      if (fp->info.constants[i].word == word &&
+          (word >= 0 || fp->info.constants[i].immediate == immediate))
+         break;
+   }
+   assert(i < 32);
+   if (i == fp->info.num_constants) {
+      fp->info.constants[i].word = word;
+      fp->info.constants[i].immediate = immediate;
+      fp->info.num_constants++;
+   }
+   struct fp_alu_src_operand value = {.index = 32 + i};
+   return value;
+}
