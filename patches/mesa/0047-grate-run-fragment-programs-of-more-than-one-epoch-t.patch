+++ b/src/gallium/drivers/grate/grate_context.c
@@ -80,6 +80,7 @@ grate_context_destroy(struct pipe_context *pcontext)
       pipe_sampler_view_reference(&context->sampler_views[i], NULL);
 
    grate_bo_unref(context->spill_bo);
