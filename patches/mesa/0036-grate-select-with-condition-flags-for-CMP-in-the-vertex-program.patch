From ba8e75cd99e6109f8fffe41b851a59ac80906397 Mon Sep 17 00:00:00 2001
From: Kayori <thatzokay@proton.me>
Date: Sun, 8 Nov 2026 00:03:59 +0100
Subject: [PATCH 2/3] grate: select with condition flags for CMP in the vertex
 program

NVIDIA's compiler has no CMP. A select is the condition flags set from
the test value by an instruction that writes no register (r63), a write
of the false value, and a write of the true value predicated on the
flag. The flags are per lane, and the predicate swizzle picks the flag.

Patch 0035 built CMP as m * (src1 - src2) + src2, which is wrong when
the two values differ a lot in size (1.0e8 against 0.2 gave 0) and NaN
when one of them is infinite. Use the select instead. It needs no zero
constant and no scratch temporaries, except when the destination is
also a source: then the result goes through a scratch temporary.

struct vp_instr gets a struct vp_condition, packed into the existing
condition and predicate fields.

Checked with tools/gpu/grate-vertex-ops-test.c (15 of 15, the installed
library fails the huge-value case) and against the layout NVIDIA's
compiler produced for the same selects (tools/gpu/ar20vp-dump.py).
---
 src/gallium/drivers/grate/vp/pack.c | 10 ++++
 src/gallium/drivers/grate/vp/tgsi.c | 83 +++++++++++++++++------------
 src/gallium/drivers/grate/vp/vpir.h | 11 ++++
 3 files changed, 69 insertions(+), 35 deletions(-)

diff --git a/src/gallium/drivers/grate/vp/pack.c b/src/gallium/drivers/grate/vp/pack.c
index 1495880d107..072ab487771 100644
--- a/src/gallium/drivers/grate/vp/pack.c
+++ b/src/gallium/drivers/grate/vp/pack.c
@@ -203,6 +203,16 @@ grate_vp_pack(uint32_t *dst, struct vp_instr *instr, bool end_of_program)
       tmp.rC_absolute = instr->scalar.src.absolute;
    }
 
+   tmp.condition_set = instr->cond.set;
+   tmp.condition_flags_write_enable = instr->cond.set;
+   if (instr->cond.check) {
+      tmp.condition_check = 1;
+      tmp.predicate_lt = instr->cond.lt;
+      tmp.predicate_eq = instr->cond.eq;
+      tmp.predicate_gt = instr->cond.gt;
+      tmp.predicate_swizzle = vp_swizzle(instr->cond.swizzle);
+   }
+
    tmp.end_of_program = end_of_program;
 
    /* copy packed instruction into destination */
diff --git a/src/gallium/drivers/grate/vp/tgsi.c b/src/gallium/drivers/grate/vp/tgsi.c
index 12cfb0102f5..e3a4887f6b2 100644
--- a/src/gallium/drivers/grate/vp/tgsi.c
+++ b/src/gallium/drivers/grate/vp/tgsi.c
@@ -355,49 +355,62 @@ tgsi_to_vp(struct grate_vp_shader *vp, const struct tgsi_full_instruction *inst)
    }
 
    case TGSI_OPCODE_CMP: {
-      /* dst = src0 < 0 ? src1 : src2, as m = (src0 < 0) ? 1 : 0 and
-       * dst = m * (src1 - src2) + src2. The vector unit has no immediate
-       * zero, so it is made as src0 - src0 (src0 is finite in practice). */
+      /* dst = src0 < 0 ? src1 : src2, laid out like NVIDIA's compiler does
+       * a select: set the condition flags from src0 (the instruction
+       * writes no register: r63), write src2, then write src1 on the
+       * lanes whose flag says less than zero. Exact, unlike a blend, and
+       * it needs no zero constant. */
       static const enum vp_swz identity[4] = {VP_SWZ_X, VP_SWZ_Y, VP_SWZ_Z,
                                               VP_SWZ_W};
-      if (vp->num_temps >= 61) {
-         fprintf(stderr, "GRATE VERTEX: out of temporaries for CMP\n");
-         vp->failed = true;
-         return 0;
+      const struct tgsi_dst_register *d = &inst->Dst[0].Register;
+      unsigned t = 0;
+      bool scratch = false;
+      /* a destination that is also a source would be overwritten before
+       * the predicated write reads it */
+      if (d->File == TGSI_FILE_TEMPORARY &&
+          ((inst->Src[1].Register.File == TGSI_FILE_TEMPORARY &&
+            inst->Src[1].Register.Index == d->Index) ||
+           (inst->Src[2].Register.File == TGSI_FILE_TEMPORARY &&
+            inst->Src[2].Register.Index == d->Index))) {
+         if (vp->num_temps >= 62) {
+            fprintf(stderr, "GRATE VERTEX: out of temporaries for CMP\n");
+            vp->failed = true;
+            return 0;
+         }
+         t = vp->num_temps++;
+         scratch = true;
       }
-      unsigned t = vp->num_temps++;
-      unsigned m = vp->num_temps++;
-      struct vp_src_operand s0 = tgsi_src_to_vp(vp, &inst->Src[0].Register);
-      struct vp_src_operand minus_s0 = s0;
-      minus_s0.negate = !s0.negate;
-      struct vp_src_operand s2 = tgsi_src_to_vp(vp, &inst->Src[2].Register);
-      struct vp_src_operand minus_s2 = s2;
-      minus_s2.negate = !s2.negate;
-
-      struct vp_instr *zero = emit_packed(
-         emit_vADD(dst_temp(t, 0xf, false), s0, minus_s0), emit_sNOP());
-      legalize_fetches(vp, zero, &vp->instructions);
-      list_addtail(&zero->link, &vp->instructions);
-
-      struct vp_instr *mask =
-         emit_packed(emit_vSLT(dst_temp(m, 0xf, false), s0,
-                               src_temp(t, identity, false, false)),
+      struct vp_dst_operand dst = scratch ? dst_temp(t, d->WriteMask, false)
+                                          : tgsi_dst_to_vp(vp, d, saturate);
+
+      struct vp_instr *flags =
+         emit_packed(emit_vMOV(dst_temp(63, d->WriteMask, false),
+                               tgsi_src_to_vp(vp, &inst->Src[0].Register)),
                      emit_sNOP());
-      legalize_fetches(vp, mask, &vp->instructions);
-      list_addtail(&mask->link, &vp->instructions);
+      flags->cond.set = true;
+      legalize_fetches(vp, flags, &vp->instructions);
+      list_addtail(&flags->link, &vp->instructions);
 
-      struct vp_instr *diff = emit_packed(
-         emit_vADD(dst_temp(t, 0xf, false),
-                   tgsi_src_to_vp(vp, &inst->Src[1].Register), minus_s2),
+      struct vp_instr *no = emit_packed(
+         emit_vMOV(dst, tgsi_src_to_vp(vp, &inst->Src[2].Register)),
          emit_sNOP());
-      legalize_fetches(vp, diff, &vp->instructions);
-      list_addtail(&diff->link, &vp->instructions);
+      legalize_fetches(vp, no, &vp->instructions);
+      list_addtail(&no->link, &vp->instructions);
 
-      return emit_packed(
-         emit_vMAD(tgsi_dst_to_vp(vp, &inst->Dst[0].Register, saturate),
-                   src_temp(m, identity, false, false),
-                   src_temp(t, identity, false, false), s2),
+      struct vp_instr *yes = emit_packed(
+         emit_vMOV(dst, tgsi_src_to_vp(vp, &inst->Src[1].Register)),
          emit_sNOP());
+      yes->cond.check = true;
+      yes->cond.lt = true;
+      memcpy(yes->cond.swizzle, identity, sizeof(identity));
+      if (!scratch)
+         return yes;
+      legalize_fetches(vp, yes, &vp->instructions);
+      list_addtail(&yes->link, &vp->instructions);
+
+      return emit_packed(emit_vMOV(tgsi_dst_to_vp(vp, d, saturate),
+                                   src_temp(t, identity, false, false)),
+                         emit_sNOP());
    }
 
    case TGSI_OPCODE_MAD:
diff --git a/src/gallium/drivers/grate/vp/vpir.h b/src/gallium/drivers/grate/vp/vpir.h
index 58a8794f3af..29e1c3349b7 100644
--- a/src/gallium/drivers/grate/vp/vpir.h
+++ b/src/gallium/drivers/grate/vp/vpir.h
@@ -103,10 +103,21 @@ struct vp_scalar_instr {
    struct vp_src_operand src;
 };
 
+/* The condition flags: one per lane, less than / equal / greater than zero,
+ * set from the vector result. An instruction may then be predicated on them
+ * (lane i of the write follows the flag selected by swizzle[i]). */
+struct vp_condition {
+   bool set;   /* set the flags from the vector result */
+   bool check; /* write only the lanes whose flag is in lt/eq/gt */
+   bool lt, eq, gt;
+   enum vp_swz swizzle[4];
+};
+
 struct vp_instr {
    struct list_head link;
    struct vp_vec_instr vec;
    struct vp_scalar_instr scalar;
+   struct vp_condition cond;
 };
 
 void
