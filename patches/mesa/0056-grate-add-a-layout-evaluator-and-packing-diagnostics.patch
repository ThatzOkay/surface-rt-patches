 src/gallium/drivers/grate/fp/layout.h     |  30 ++
 src/gallium/drivers/grate/fp/tgsi.c       |   3 +
 src/gallium/drivers/grate/grate_program.c | 385 +++++++++++++++++++-
 src/gallium/drivers/grate/meson.build     |   2 +
 5 files changed, 837 insertions(+), 1 deletion(-)
