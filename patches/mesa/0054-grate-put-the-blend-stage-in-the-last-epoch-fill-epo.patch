    uint32_t blend_words[GRATE_FP_BLEND_MAX_PACKETS * 8];
    unsigned packets = grate_fp_blend_alu(key, blend_words);
 
-   if (!packets || fp_count + rows > 64 || alu_count + packets > 64 ||
-       fp_count % rows)
