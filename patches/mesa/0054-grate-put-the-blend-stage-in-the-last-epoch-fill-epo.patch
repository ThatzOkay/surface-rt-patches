 src/gallium/drivers/grate/grate_program.c  | 171 +++++++++++++++++++--
 src/gallium/drivers/grate/grate_program.h  |   9 +-
 src/gallium/drivers/grate/grate_state.c    |  18 ++-
 4 files changed, 176 insertions(+), 23 deletions(-)

