From a00b3ff12d1d990e56a11683d397a58f75a74824 Mon Sep 17 00:00:00 2001
From: Kayori <thatzokay@proton.me>
Date: Wed, 11 Nov 2026 11:58:50 +0100
Subject: [PATCH] grate: compile SQRT and SEQ in the vertex program

The vertex compiler refused TGSI SQRT (0x14) and SEQ (0x2d), which
skipped or reduced the draws of the glmark2 buffer tests (48 to 72 FPS).

The vector unit has a SEQ op (16, already in vpir.h), so SEQ is the
same one-instruction case as SNE. The scalar unit has no square root.
NVIDIA's vertex compiler (the Android one on the tablet, decoded with
ar20vp-dump.py) computes sqrt(x) as RCP(RSQ(x)), one lane at a time
through a temporary, and equal() as the vector SEQ. Do the same: an RSQ
into a scratch temporary, then an RCP of it into the destination. That
keeps sqrt(0) = RCP(inf) = 0, where x * RSQ(x) would give 0 * inf = NaN.

Checked on the tablet with seven new cases of grate-vertex-ops-test
(seq, seq with a swizzled operand, sqrt of an attribute, of a uniform, of
one scalar, with a write mask, and of max(c, 0.0) so that zero is
covered); with the older cases all 22 pass.
---
 src/gallium/drivers/grate/vp/tgsi.c | 31 +++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/src/gallium/drivers/grate/vp/tgsi.c b/src/gallium/drivers/grate/vp/tgsi.c
index e3a4887f6b2..0ed5bda5ead 100644
--- a/src/gallium/drivers/grate/vp/tgsi.c
+++ b/src/gallium/drivers/grate/vp/tgsi.c
@@ -163,6 +163,7 @@ GEN_V_BINOP(SLT)
 GEN_V_BINOP(MAX)
 GEN_V_BINOP(MIN)
 GEN_V_BINOP(SNE)
+GEN_V_BINOP(SEQ)
 
 static struct vp_vec_instr
 emit_vMAD(struct vp_dst_operand dst, struct vp_src_operand src0,
@@ -327,6 +328,36 @@ tgsi_to_vp(struct grate_vp_shader *vp, const struct tgsi_full_instruction *inst)
                    tgsi_src_to_vp(vp, &inst->Src[1].Register)),
          emit_sNOP());
 
+   case TGSI_OPCODE_SEQ:
+      return emit_packed(
+         emit_vSEQ(tgsi_dst_to_vp(vp, &inst->Dst[0].Register, saturate),
+                   tgsi_src_to_vp(vp, &inst->Src[0].Register),
+                   tgsi_src_to_vp(vp, &inst->Src[1].Register)),
+         emit_sNOP());
+
+   case TGSI_OPCODE_SQRT: {
+      /* The scalar unit has no square root. NVIDIA's compiler computes
+       * sqrt(x) = RCP(RSQ(x)), which keeps sqrt(0) = RCP(inf) = 0, where
+       * x * RSQ(x) would give 0 * inf = NaN. */
+      static const enum vp_swz xxxx[4] = {VP_SWZ_X, VP_SWZ_X, VP_SWZ_X,
+                                          VP_SWZ_X};
+      if (vp->num_temps >= 62) {
+         fprintf(stderr, "GRATE VERTEX: out of temporaries for SQRT\n");
+         vp->failed = true;
+         return 0;
+      }
+      unsigned t = vp->num_temps++;
+      struct vp_instr *rsq = emit_packed(
+         emit_vNOP(), emit_sRSQ(dst_temp(t, 0xf, false),
+                                tgsi_src_to_vp(vp, &inst->Src[0].Register)));
+      legalize_fetches(vp, rsq, &vp->instructions);
+      list_addtail(&rsq->link, &vp->instructions);
+      return emit_packed(
+         emit_vNOP(),
+         emit_sRCP(tgsi_dst_to_vp(vp, &inst->Dst[0].Register, saturate),
+                   src_temp(t, xxxx, false, false)));
+   }
+
    case TGSI_OPCODE_DP2: {
       /* The vector unit has no two-component dot product. t = a * b, then
        * dst = t.x + t.y in every lane (TGSI replicates the result). */
-- 
