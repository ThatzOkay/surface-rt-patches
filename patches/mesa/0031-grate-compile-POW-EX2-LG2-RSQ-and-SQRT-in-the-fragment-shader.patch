    /* C: destination <- row */
@@ -719,7 +802,12 @@ emit_tgsi_instr(struct grate_fp_shader *fp, const struct tgsi_full_instruction *
       emit_TEX(fp, inst);
       break;
    case TGSI_OPCODE_RCP:
