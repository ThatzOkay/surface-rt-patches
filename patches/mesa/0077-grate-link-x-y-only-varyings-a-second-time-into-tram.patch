From 5c53372e2ca5402a3b5bcf5c5e22ee817ce2172b Mon Sep 17 00:00:00 2001
From: Kayori <thatzokay@proton.me>
Date: Thu, 19 Nov 2026 21:22:23 +0100
Subject: [PATCH] grate: link x/y-only varyings a second time into tram columns
 2 and 3

A varying of which the fragment program reads x and y only gets a
second setup instruction with the same source and the same tram row,
sending x to column 2 and y to column 3. Reading var2/var3 of that row
then returns the same x/y as var0/var1, so an interpolation can write
R2/R3 as well as R0/R1.

NVIDIA's compiler does this: its tram row allocator (libcgdrv.so,
read with REA/Ghidra) allocates such a varying twice, the second slot
tagged 0x20000. Its vertex program writes o7.xy only, so nothing
changes in the vertex shader. cgtest on small shaders shows a lone
vec2 varying read through var2/var3 with TEX 0x430.

grate_fp_info gets dup_inputs/dup_rows; grate_state.c emits them after
the regular inputs; the layout evaluator hashes lane k & 1 for the
interpolations of such rows. Colour varyings and rows that use z or w
are left alone (Mesa packs varyings, so a row can hold a float and a
vec2). GRATE_NO_DUP_LINK=1 turns the link off.

Checked on the tablet: without the link, interpolating into var2/var3
read z and w (0 and 1) and rendered the wrong texel; with it all cases
of tools/gpu/grate-texture-lane-test pass, the 36 self-checking tests
give the same last line as the installed library, and glmark2 runs all
32 scenes.
---
 src/gallium/drivers/grate/fp/layout.c      | 11 ++++++++++-
 src/gallium/drivers/grate/fp/tgsi.c        | 19 +++++++++++++++++++
 src/gallium/drivers/grate/grate_compiler.h | 12 ++++++++++++
 src/gallium/drivers/grate/grate_state.c    | 14 ++++++++++----
 4 files changed, 51 insertions(+), 5 deletions(-)

diff --git a/src/gallium/drivers/grate/fp/layout.c b/src/gallium/drivers/grate/fp/layout.c
index 493571daf86..e752bc9610e 100644
--- a/src/gallium/drivers/grate/fp/layout.c
+++ b/src/gallium/drivers/grate/fp/layout.c
@@ -45,6 +45,9 @@ struct lo_eval {
     * the 2x2 quad, and r32, r40, r48 and r56 return the four pixels'
     * values exactly two packets later (docs/grate-derivatives.md). */
    bool derivatives;
+   /* tram rows linked twice (columns 0/1 and 2/3, grate_fp_info.dup_rows):
+    * var2/var3 of such a row read the same x/y as var0/var1 */
+   uint32_t dup_rows;
    bool quad_valid;
    uint64_t quad_value;
    int64_t quad_g;
@@ -343,7 +346,12 @@ lo_units(struct lo_eval *e, const struct fp_instr *instr,
          }
          lo_write_unit = true;
          lo_write_step = step;
-         uint64_t a[] = {0x1a7e, m->var[k].tram_row, k};
+         const unsigned lane =
+            m->var[k].tram_row < 32 &&
+                  (e->dup_rows >> m->var[k].tram_row & 1)
+               ? (k & 1)
+               : k;
+         uint64_t a[] = {0x1a7e, m->var[k].tram_row, lane};
          uint64_t r = mixn(3, a);
          if (getenv("GRATE_LAYOUT_TRACE"))
             fprintf(stderr, "  %s step %u interp var%u row %u = %08x\n",
@@ -406,6 +414,7 @@ lo_signature(const struct grate_fp_shader *fp, bool sequential,
    struct lo_eval *e = &e_storage;
    e->sequential = sequential;
    e->derivatives = fp->uses_derivatives;
+   e->dup_rows = fp->info.dup_rows;
    e->quad_valid = false;
    e->rows = sequential ? 1 : MAX2(fp->info.num_rows, 1);
    e->num_writes = 0;
diff --git a/src/gallium/drivers/grate/fp/tgsi.c b/src/gallium/drivers/grate/fp/tgsi.c
index 789ee968969..c28ed950b92 100644
--- a/src/gallium/drivers/grate/fp/tgsi.c
+++ b/src/gallium/drivers/grate/fp/tgsi.c
@@ -1679,6 +1679,20 @@ emit_tgsi_input(struct grate_fp_shader *fp, const struct tgsi_full_declaration *
    if (getenv("GRATE_INDST") &&
        fp->info.num_inputs == 0) /* EXPERIMENT hook */
       dst = strtoul(getenv("GRATE_INDST"), NULL, 16);
+   const unsigned row = decl->Range.First;
+   /* x and y only: link them into columns 2 and 3 as well */
+   if (decl->Declaration.UsageMask && !(decl->Declaration.UsageMask & 0xc) &&
+       decl->Declaration.Semantic != TGSI_SEMANTIC_COLOR && row < 32 &&
+       fp->info.num_dup_inputs < ARRAY_SIZE(fp->info.dup_inputs) &&
+       !getenv("GRATE_NO_DUP_LINK") &&
+       !(getenv("GRATE_INDST") && fp->info.num_inputs == 0)) {
+      dst = LINK_DST(0, 0, LINK_DST_FP20) | LINK_DST(1, 1, LINK_DST_FP20);
+      fp->info.dup_inputs[fp->info.num_dup_inputs].src = src;
+      fp->info.dup_inputs[fp->info.num_dup_inputs].dst =
+         LINK_DST(0, 2, LINK_DST_FP20) | LINK_DST(1, 3, LINK_DST_FP20);
+      fp->info.num_dup_inputs++;
+      fp->info.dup_rows |= 1u << row;
+   }
    fp->info.inputs[fp->info.num_inputs].src = src;
    fp->info.inputs[fp->info.num_inputs].dst = dst;
 
@@ -1716,6 +1730,9 @@ emit_direct_varying_product(struct grate_fp_shader *fp,
    };
    fp->info.num_inputs = 8;
    fp->info.max_tram_row = 8;
+   /* its own link table: no second links */
+   fp->info.num_dup_inputs = 0;
+   fp->info.dup_rows = 0;
    for (unsigned c = 0; c < 4; c++) {
       for (unsigned operand = 0; operand < 2; operand++) {
          unsigned row = c * 2 + operand;
@@ -2505,6 +2522,8 @@ grate_tgsi_to_fp(struct grate_fp_shader *fp, struct tgsi_parse_context *tgsi,
    list_inithead(&fp->mfu_instructions);
 
    fp->info.num_inputs = 0;
+   fp->info.num_dup_inputs = 0;
+   fp->info.dup_rows = 0;
    fp->info.num_constants = 0;
    fp->info.num_spill_slots = 0;
    fp->info.color_input = -1;
diff --git a/src/gallium/drivers/grate/grate_compiler.h b/src/gallium/drivers/grate/grate_compiler.h
index b6baed1d843..b92dcf21561 100644
--- a/src/gallium/drivers/grate/grate_compiler.h
+++ b/src/gallium/drivers/grate/grate_compiler.h
@@ -92,6 +92,18 @@ struct grate_fp_info {
    int num_inputs;
    int color_input;
    int max_tram_row;
+   /* A varying of which the fragment program reads x and y only is linked a
+    * second time into the same tram row, columns 2 and 3 (a second setup
+    * instruction with the same source): var2/var3 of that row read the same
+    * x/y as var0/var1, so an interpolation can write R2/R3 as well as R0/R1.
+    * NVIDIA's compiler allocates such a varying twice (tram row allocator of
+    * libcgdrv.so); dup_rows has a bit for every tram row done this way. */
+   struct {
+      uint32_t src;
+      uint32_t dst;
+   } dup_inputs[8];
+   unsigned num_dup_inputs;
+   uint32_t dup_rows;
    /* Scalar hardware constants: uniforms point into TGSI constant buffer 0;
     * immediates share the same 32-entry FP20 bank. */
    struct {
diff --git a/src/gallium/drivers/grate/grate_state.c b/src/gallium/drivers/grate/grate_state.c
index d71e4cbc316..b7f5f230f60 100644
--- a/src/gallium/drivers/grate/grate_state.c
+++ b/src/gallium/drivers/grate/grate_state.c
@@ -1095,18 +1095,24 @@ emit_program(struct grate_context *context, uint32_t **ptrp)
 
    /* depends on linking */
    struct grate_fp_info *info = &context->fshader->info;
-   cull_face_linker_setup |= TGR3D_SU_PARAM_LAST_INST(0 < info->num_inputs ?
-                                                      (info->num_inputs - 1) : 0);
+   const unsigned num_insts = info->num_inputs + info->num_dup_inputs;
+   cull_face_linker_setup |= TGR3D_SU_PARAM_LAST_INST(0 < num_insts ?
+                                                      (num_insts - 1) : 0);
 
-   uint32_t linker_insts[3 + info->num_inputs * 2];
+   uint32_t linker_insts[3 + num_insts * 2];
    linker_insts[0] = host1x_opcode_incr(REG_TGR3D_SU_PARAM, 1);
    linker_insts[1] = cull_face_linker_setup;
-   linker_insts[2] = host1x_opcode_incr(REG_TGR3D_SU_INST_EVEN(0), info->num_inputs * 2);
+   linker_insts[2] = host1x_opcode_incr(REG_TGR3D_SU_INST_EVEN(0), num_insts * 2);
 
    for (int i = 0; i < info->num_inputs; ++i) {
       linker_insts[3 + i * 2] = info->inputs[i].src;
       linker_insts[3 + i * 2 + 1] = info->inputs[i].dst;
    }
+   /* the second link of the varyings that also fill columns 2 and 3 */
+   for (unsigned i = 0; i < info->num_dup_inputs; ++i) {
+      linker_insts[3 + (info->num_inputs + i) * 2] = info->dup_inputs[i].src;
+      linker_insts[3 + (info->num_inputs + i) * 2 + 1] = info->dup_inputs[i].dst;
+   }
 
    if (context->rast->base.flatshade && info->color_input >= 0)
       linker_insts[3 + info->color_input * 2 + 1] |= 0xf << 16;
-- 
2.56.0

